# Seguimiento de cuerpo sin renderizado, para BodyTracker (backend gpu).
# El stream de entrada es GpuBuffer: libhand_tracker inserta la conversión desde ImageFrame.
# Uso: graphPath = ".../pose_tracking_{backend}.pbtxt"

input_stream: "input_video"

node {
  calculator: "PoseLandmarkGpu"
  input_stream: "IMAGE:input_video"
  output_stream: "LANDMARKS:pose_landmarks"
  output_stream: "WORLD_LANDMARKS:pose_world_landmarks"
}
